# SPEED TRAX course select. Controller 2 holds L and presses SELECT seven
# times: the built-in code that opens every course and class (and saves it).
hold 2.L 10
hold 2.SELECT+2.L 4
hold 2.L 6
hold 2.SELECT+2.L 4
hold 2.L 6
hold 2.SELECT+2.L 4
hold 2.L 6
hold 2.SELECT+2.L 4
hold 2.L 6
hold 2.SELECT+2.L 4
hold 2.L 6
hold 2.SELECT+2.L 4
hold 2.L 6
hold 2.SELECT+2.L 4
hold 2.L 6
