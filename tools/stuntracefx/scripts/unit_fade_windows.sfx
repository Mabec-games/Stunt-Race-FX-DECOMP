# unit_fade_windows: unit tests (call) from the start of a Novice race: the
# fade-in step at every level (its whole step table), the window bands in
# states 3 and 6, and the split window in state 3, in state 6 and closing
# from state 2 to its end; the split-screen window layout.
load build/stuntracefx/states/novice_coupe_race1.state
set 7E0E3A 00
set 7E0D60 00,00
call 7E:AC69 p=30 db=00 d=0000
wait 1
