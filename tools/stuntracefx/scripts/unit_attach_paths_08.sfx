set 7E2031 80
call 08:E073 long x=0001 p=20 db=7E d=0000
load build/stuntracefx/states/novice_coupe_race1.state
set 7E2007 01,00
call 08:E158 long x=0001 p=20 db=7E d=0000
load build/stuntracefx/states/novice_coupe_race1.state
