# unit_unused_screen: unit tests (call) from the start of a Novice race for
# the bank 02 helpers of the unused screen, which nothing in the game
# calls: the scroll clear, the palette loads (palette 3 to CGRAM, 5 to the
# buffers, with 16-bit and 8-bit index registers), the red doubling (reds
# 1, 3, 8, $1F and $10 staged at $0722), the colour clear, the $7E:BC2A
# values, the blank and scanline waits, the registers reset (long and by
# JSR), the tile row build (off; level $0300 forwards; level $FC00
# backwards; each again with its row already recorded at $08E8, and level
# $0700, whose table entry repeats $8D02), the row upload (long and by JSR)
# and the two Super FX clears (with $01C4 set and clear).
# Last, TileRowBuildZero 02:D96E (the LDA #0 nothing reaches) by a direct
# call.
load build/stuntracefx/states/novice_coupe_race1.state
call 02:D4A3 long p=00 db=00 d=0000
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
call 02:D4D8 long a=0003 p=00 db=00 d=0000
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
call 02:D4D8 long a=0103 p=30 db=00 d=0000
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
call 02:D506 long a=0005 p=00 db=00 d=0000
wait 1
