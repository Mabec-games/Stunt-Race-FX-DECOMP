wait 1
load build/stuntracefx/states/novice_coupe_race1.state
fx 04:CB7E stop=888C r1=7FFF r5=1918 r8=1738 r10=0244
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
set 701750 00,00
fx 04:A301 stop=888C r7=1738 r10=0244
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
set 701750 18,19
fx 04:A301 stop=888C r7=1738 r10=0244
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
fx 04:93FA stop=888C
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
fx 04:BCA5 stop=888C r0=0050
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
fx 04:BCA5 stop=888C r0=0300
wait 1
