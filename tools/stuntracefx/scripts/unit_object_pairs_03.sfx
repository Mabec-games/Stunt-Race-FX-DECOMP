# unit_object_pairs_03: unit tests (call) from the start of a Novice race
# for the 16-bit multiply 02:DF95/DF99 and the object pair code at
# 03:C6F4-C997, which nothing in the game calls. The multiply on +$1234
# and -$1234 by +$40 and -$40; the wide rotations by angle $20 on ($0300,
# $0500) and ($FD00, $0480), with 16-bit and 8-bit index registers. The
# pair calls stage two records: $62 at $1000,$0100,$2000 with velocity
# $10,-$10,$20 and $C4 at $1100,$0080,$2050 with velocity 3,5,-7; offsets
# and points in $04, $0A and $05F2 give each sign of each difference.
load build/stuntracefx/states/novice_coupe_race1.state
set 7E2062 C4,00
set 7E2066 05,00
set 7E206E 00,10,00,01,00,20
set 7E2090 10,00,F0,FF,20,00
set 7E20C4 26,01
set 7E20C8 07,00
set 7E20D0 00,11,80,00,50,20
set 7E20F2 03,00,05,00,F9,FF
set 7E0067 34,12,40
call 02:DF99 p=30 db=00 d=0000
wait 1
