# unit_replay_camera_08: the replay camera director's handlers of bank $08
# (08:8F03-958E) that no play reaches (or not on every path), as calls on
# object 1 ($2001) of a Novice race's state made a director: its camera
# link +$4F = the camera at $1A64 and its car +$06 = itself. Each handler
# and frame once; the counting frames with +$48 at 0 and 5, the flash
# frame's +$25 bit 0 with the camera's +$34 at 0 and 1 and the object far below the camera, the path start in
# HUD mode 3, and the snap 08:8F03 by JSR.
load build/stuntracefx/states/novice_coupe_race1.state
set 7E2007 01,00
set 7E2050 64,1A
call 08:8F03 x=0001 p=20 db=7E d=0000
