# unit_fx: unit tests (fx) of Super FX routines on paths no script reaches,
# each started on its own with the registers a real call had (R11 = a STOP
# in its bank: $04:888C, $07:EE86, $01:80E3):
# - FxRecordsApart, the battle cars $1AF8 and $1CD8 with both sizes (+$0C)
#   0, so their sum less $294 is clamped to 0;
# - FxGlyph8x8 and FxGlyph16x32 with no glyph ($70:0216 = 0), kept so the
#   next program runs the NOP after each one's STOP; then
#   FxPolygonClipTop with a 2-vertex polygon ($40 = 2);
# - FxCarHit on the player's record $1738 (+$64 and +$40 cleared) with $263C
#   set and $400 already in $263E, so half the sum is held at 96.
# - FxPoolTake asked for $32 bytes when the first pool's head has size 0
#   and its first block $34, so the block is taken whole; FxCarAddPart
#   with the first pool empty ($1098-$109B = 0), so there is no room;
# - FxCarCatchUp on record $1918 with +$72 = $FFFF and segment +$58 = 0;
#   FxCourseNearest with $1092 = 0; FxNearestCar with $262E = 0;
# - FxDivide32By16Halving and FxDivideHalvedIfLarge with R0 negative;
# - the right, left, bottom and near polygon clips with a 2-vertex polygon.
# - FxObjectFree on battle car $1AF8, whose parts are freed with it
#   (FxObjectFreeChildren); FxSegmentCrossZ with both ends' z (R3, R6)
#   positive and both negative; FxContactNote for record $210C (bit 7 of
#   +$16 cleared, no contacts) and $2136 with the first pool cut to its
#   first block, of $14 bytes, so the $12-byte contact takes it whole.
# - FxSteerFromInput on the player's record: with bit 10 of +$40 set and
#   +$4A negative; with no steering and +$3A far negative and far positive
#   (past $266A either way); FxCourseNextEntry with bit 1 of +$70 set.
# - FxSumsPushWorld and FxSumsPushLocal with a push past +5000 and past
#   -5000 on every axis; FxTimersProgram with timed record 0 at 16 and bit 4
#   of its flags set; FxCarNew with script $8886, with an unknown script
#   ($8000) and with the first pool empty.
# - FxClipYPlane and FxClipXPlane with both ends below the plane;
#   FxClipNear with a negative plane (R14 = -256) and both ends in front,
#   then both behind.
# - FxCarPlaceOnSegment on car $1918 (its linked objects with lists, so
#   each is swept) and with its segment +$58 = 0; FxDriveDecide for car
#   $1AF8 with bit 14 of +$40 set and a point far to each side, and with
#   +$7E at 20 while stopped (the reversing turn).
load build/stuntracefx/states/battle_04.state
set 701B04 00,00
set 701CE4 00,00
fx 04:CA99 stop=888C r7=1AF8 r8=1CD8 r10=0244
wait 1
