# unit_dead_7e_f141: a unit test of 7E:F141, the arm after
# ObjectGroupsActivate's RTS that nothing reaches (bit 1 of object Y's +$08
# cleared, then back into its chain loop), from the start of a Novice
# race: entered by JSR with the P and data bank the routine pulls at its
# end on the stack (frame=), the trigger list at $1AF5 empty from
# $1F2B = 0; on object 1 alone in its chain (+$3C = 0), and on object 1
# chained to $63.
load build/stuntracefx/states/novice_coupe_race1.state
set 7E1F2B 00,00
set 7E1AF5 00,00
set 7E203D 00,00
call 7E:F141 frame=3000 x=0040 y=0001 p=00 db=7E d=0000
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
set 7E1F2B 00,00
set 7E1AF5 00,00
set 7E203D 63,00
set 7E209F 00,00
call 7E:F141 frame=2000 x=0040 y=0001 p=00 db=7E d=0000
wait 1
