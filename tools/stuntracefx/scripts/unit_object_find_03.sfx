# unit_object_find_03: unit tests (call) from the start of a Novice race
# for the object searches at 03:C08F-C27E, CA19 and CA85, which nothing in
# the game calls. Each call stages its own list at $0325 of three records:
# $62 (kind 5, at $1000,$0100,$2000, flag 1, half sizes $80), $C4 (kind 7,
# at $1100,$0080,$2050, flag 2, half sizes $200) and $126 (kind 5, at
# $3000,$FE00,$4000, flags 3, half sizes $10), and then the search's own
# inputs: the point in $02/$08, the resume point $1F30, the self object in
# X, the kind in A, the flag mask in $02, the distance window $42-$3E.
load build/stuntracefx/states/novice_coupe_race1.state
set 7E0325 62,00
set 7E2062 C4,00
set 7E2066 05,00
set 7E206E 00,10,00,01,00,20
set 7E2086 01
set 7E2089 80,00,80,00
set 7E20C4 26,01
set 7E20C8 07,00
set 7E20D0 00,11,80,00,50,20
set 7E20E8 02
set 7E20EB 00,02,00,02
set 7E2126 00,00
set 7E212A 05,00
set 7E2132 00,30,00,FE,00,40
set 7E214A 03
set 7E214D 10,00,10,00
set 7E0002 50,10
set 7E0008 10,20
call 03:C08F long p=00 db=7E d=0000
wait 1
