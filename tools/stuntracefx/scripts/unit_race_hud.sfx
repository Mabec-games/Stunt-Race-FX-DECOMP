# unit_race_hud: RaceSoundsAndHud's paths no play reaches, as calls from
# the start of a Novice race (HUD mode 0) and from Stunt Trax at Icedance
# (mode 1): mode 0 with $0D24 = 3 at phase 8, the fade running and done
# (on at WindowDigitStepEC6B: noreturn); mode 1 with $0D4E set
# (TimeUpPhaseStep, HudBlankDraw); TimeUpPhaseStep for each phase and
# its handlers on each path, each also as a call (TimeUpPhaseRace at the
# 9:59.99 limit, with
# $1F71 set and clear; TimeUpPhaseEnd counting with player 1 behind and
# ahead and at 0); RaceHudModeTwo (07:DC47, entered with the data bank
# and P on the stack, as RaceSoundsAndHud's jump leaves them); and the
# race's end loops RaceEndCountdownFade (07:DC88) and RaceEndCountdown
# (07:DCCA), which go on into the results (noreturn); the screen loops
# they run end with the fade done ($0D61 negative, or a fade out started
# with $0E3A); the glyph slides (07:A451, 07:A492) at their limits and
# counts; HudBlankDraw (07:A6DD) for $1F71 = 1-3; TimeUpRecordUpdate
# (07:AD1B) slower than and equal to the record; their last steps
# RaceEndCountdownFadeOn (07:DCAE) and
# RaceEndCountdownOn (07:DCDF) with $0DD4 set; and HUD mode 2.
load build/stuntracefx/states/novice_coupe_race1.state
set 7E0D24 03
set 7E0DD6 08
set 7E0D61 00
call 07:DAA7 long p=30 db=00 d=0000
