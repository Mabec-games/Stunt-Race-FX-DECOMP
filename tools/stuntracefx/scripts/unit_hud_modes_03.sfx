# unit_hud_modes_03: unit calls (call) of the one-player race HUD set-up
# (03:DECA, entered with the P and data bank RaceHudLoad pushes) from the
# start of a Novice race, once for each HUD mode path the races in the
# other scripts never take. HUD mode $0D2B: 1 Stunt Trax, 2 Battle Trax,
# 3 all courses. All courses: $10CD set (as Speed Trax), $0D4C clear with
# $0F2B $FFFF (no time) or a time, $0D4C set with the course's record at
# $70:FC5E $FFFF or a time (course $14, record 0). Stunt Trax: $0D4E set
# with the course's record at $70:FC4A $FFFF or a time (course $17, record
# 0), $0D4E clear. Battle Trax: $10CD set, $0D4C set.
load build/stuntracefx/states/novice_coupe_race1.state
set 7E0D2B 03
set 7E10CD 00
set 7E0D4C 00
set 7E0F2B FF,FF
call 03:DECA long frame=2000 p=30 db=03 d=0000
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
set 7E0D2B 03
set 7E10CD 00
set 7E0D4C 00
set 7E0F2B 59,23
call 03:DECA long frame=2000 p=30 db=03 d=0000
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
set 7E0D2B 03
set 7E10CD 00
set 7E0D4C 01
set 7E0E3D 14,00
set 70FC5E FF,FF
call 03:DECA long frame=2000 p=30 db=03 d=0000
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
set 7E0D2B 03
set 7E10CD 00
set 7E0D4C 01
set 7E0E3D 14,00
set 70FC5E 59,23
call 03:DECA long frame=2000 p=30 db=03 d=0000
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
set 7E0D2B 03
set 7E10CD 01
call 03:DECA long frame=2000 p=30 db=03 d=0000
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
set 7E0D2B 01
set 7E0D4E 01
set 7E0E3D 17,00
set 70FC4A FF,FF
call 03:DECA long frame=2000 p=30 db=03 d=0000
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
set 7E0D2B 01
set 7E0D4E 01
set 7E0E3D 17,00
set 70FC4A 59,23
call 03:DECA long frame=2000 p=30 db=03 d=0000
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
set 7E0D2B 01
set 7E0D4E 00
call 03:DECA long frame=2000 p=30 db=03 d=0000
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
set 7E0D2B 02
set 7E10CD 01
call 03:DECA long frame=2000 p=30 db=03 d=0000
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
set 7E0D2B 02
set 7E10CD 00
set 7E0D4C 01
call 03:DECA long frame=2000 p=30 db=03 d=0000
wait 1
