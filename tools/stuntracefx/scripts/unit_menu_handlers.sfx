# unit_menu_handlers: unit tests (call) from the start of a Novice race, with
# a one-entry menu actor list built in low work RAM: the kind 4 animation
# change of the slide to the preview, the initials frame's back (Y) and the
# settings' exit (B); initials left and a letter wrapping up.
# MenuBg1RiseAway with the background still below its start (y $20 >= 0).
load build/stuntracefx/states/novice_coupe_race1.state
set 7E11F7 02,00
set 7E1239 80,1F
set 7E1F9A 04,00
set 7E1F94 00,00
set 7E1F2A 7E,00
set 7E11F9 20,1F
call 0B:C5EF x=1F20 p=00 db=00 d=0000
wait 1
