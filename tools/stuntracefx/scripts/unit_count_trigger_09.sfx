# unit_count_trigger_09: the object that starts the counting markers
# (09:B0BE-B132), which play enters only by the handler dispatch (A5
# skips those), called on object 1 of a Novice race: its set-up, its
# restart, and its frame with no contact and with a car's contact staged
# in Super FX RAM as in unit_gates_09, with +$25 bit 0 clear and set.
load build/stuntracefx/states/novice_coupe_race1.state
call 09:B0BE long x=0001 p=20 db=7E d=0000
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
call 09:B0DC long x=0001 p=20 db=7E d=0000
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
call 09:B103 long x=0001 p=20 db=7E d=0000
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
set 7E2023 00,50
set 70501C 00,00
set 70502C 00,00
set 705018 00,51
set 705110 02,00
set 70510E 00,00
set 70510C 00,52
set 705216 02,00
set 705264 01,00
set 7E2026 00
call 09:B103 long x=0001 p=20 db=7E d=0000
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
set 7E2023 00,50
set 70501C 00,00
set 70502C 00,00
set 705018 00,51
set 705110 02,00
set 70510E 00,00
set 70510C 00,52
set 705216 02,00
set 705264 01,00
set 7E2026 01
call 09:B103 long x=0001 p=20 db=7E d=0000
wait 1
