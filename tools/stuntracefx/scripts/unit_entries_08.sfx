# unit_entries_08: the bank $08 object handlers a play enters only by
# their object's handler word (the RTL dispatch), so no call of their own
# reaches A5: each called directly on object 1 of a Novice race's state,
# its parent +$06 set to itself. The replay camera director's entries with
# object 1 made a director (link +$4F = $1A64); the rings' starts and
# spin, a ring part's start, the demo car's start and frame, the flying
# part's return, a child's start, frame and return, the break-off pieces
# and their fall, the attachment's frame, the spark's start, a carried
# car's frame, the lamp's start, wait, drop and bounce start, a burst
# piece's start, the blinker's rise and the pace car's start and frame;
# the lamp's bounce (ObjectLampDropB) counting and at its end (+$49 = 5,
# so the count reaches $1F59 = 6 on the falling side).
load build/stuntracefx/states/novice_coupe_race1.state
set 7E2007 01,00
set 7E2050 64,1A
call 08:8B5B long x=0001 p=20 db=7E d=0000
