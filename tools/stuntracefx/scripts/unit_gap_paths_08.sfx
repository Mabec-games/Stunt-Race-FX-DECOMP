# unit_gap_paths_08: the paths of bank $08 routines with C that neither a
# play nor the other unit scripts reach, as calls in a Novice race's
# state. CameraNearestCar on object 1 with car 2 ($2063, behind it on all
# three axes) first in the car list at $7E:FFAE and the camera's distance
# $7FFF, so car 2 is taken. CameraPointFromTable on object 1 made a
# director (link $1A64) with +$25 bits 0 and 1 and the point on the last
# place of list $0A (3 places from 1), so the back step wraps to 0.
# ObjectChildFollow on car 2 as a child of car 1 whose record's +$2C has
# bit 11 and +$46 bits 0 and 4: fast backwards with a free object, fast
# forwards with none ($0CEE = $2E) and still. ObjectSyncAngles on object 1
# with no record (+$22 = 0). ObjectAttachSpawn with its list (from
# $70:2392) in low RAM through the bank $0A mirror: one piece of template
# 9 (handler $08:DE31) with a Z speed of -$70. ObjectOffsetOnParent2 with
# the parent hidden (+$24 bit 3), dropped (+$24 bit 5) and with every
# speed negative. ObjectLampOnParent with the parent's +$25 bit 5.
load build/stuntracefx/states/novice_coupe_race1.state
set 7EFFAE 63,00
set 7E1A6A FF,7F
call 08:8A8A long x=0001 p=20 db=7E d=0000
