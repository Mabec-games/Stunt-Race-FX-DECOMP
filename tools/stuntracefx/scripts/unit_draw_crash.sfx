# unit_draw_crash: unit tests (call) from the start of a Novice race: the big
# sprite rows' count draw ($0E5C set), the backdrop scroll's cap (half 0:
# half 1 follows player 2's vehicle, none in this race, to open bus), and two
# paths that stop the game (noreturn, the state loaded again after): a
# record step with no record (CrashWhite) and a script spawn with no free
# object (CrashGreen).
load build/stuntracefx/states/novice_coupe_race1.state
set 7E0E5C 01
call 07:9D67 p=00 db=00 d=0000
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
set 7E0E5C 01
call 07:9E3B p=00 db=00 d=0000
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
set 7E06CD 00,04
set 7E0D7F 00
call 7E:E924 p=10 db=00 d=0000
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
set 7E0D53 01
set 7E4F9B 00,00
call 08:B5B3 long noreturn frames=3 x=2F79 p=20 db=7E d=0000
load build/stuntracefx/states/novice_coupe_race1.state
set 7E032D 00,00
# the spawn runs on a course script's data bank ($05, as the game runs
# them): on $7F it read the free count from bank $7F and never stopped
call 08:826E noreturn frames=3 y=0000 p=00 db=05 d=0000
load build/stuntracefx/states/novice_coupe_race1.state
wait 1
