# unit_handoff_entries: unit calls of the entries whose C the routines that
# jump to them now call: BootWarm from its race (03:8BCD, RaceRestart's
# way back in) and from its attract race (03:8BF8, RaceEndToAttract's),
# which never return; ViewSetup (03:AE70), which nothing in the game calls;
# and the pause loops from inside (07:BB16, 07:BB7C), as PauseResults and
# PauseResultsP2 enter them (stage $0A, $0D2D = $0A), run until a stage
# ends them.
load build/stuntracefx/states/novice_coupe_race1.state
call 03:8BCD long p=20 db=03 d=0000 noreturn frames=240
load build/stuntracefx/states/novice_coupe_race1.state
call 03:8BF8 long p=20 db=03 d=0000 noreturn frames=240
load build/stuntracefx/states/novice_coupe_race1.state
call 03:AE70 long p=30 db=03 d=0000
load build/stuntracefx/states/novice_coupe_race1.state
set 7E0D2F 0A
set 7E0D2D 0A
call 07:BB16 php p=30 db=07 d=0000 noreturn frames=30
load build/stuntracefx/states/novice_coupe_race1.state
set 7E0D2F 0A
set 7E0D2D 0A
call 07:BB7C php p=30 db=07 d=0000 noreturn frames=30
