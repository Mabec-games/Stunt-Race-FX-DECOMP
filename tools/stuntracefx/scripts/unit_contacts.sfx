# unit_contacts: unit tests (call) from the start of a Novice race: the
# contact flags for each lowest contact bit, a word with none of bits 0-2,
# flags bit 0 and bit 11; the contact list walked past an entry to a found
# one, and walked to its end, in unused Super FX RAM.
load build/stuntracefx/states/novice_coupe_race1.state
set 7E1F3A 01,00
set 7E1F36 00,00
set 7E1F38 00,00
call 08:D01E p=00 db=00 d=0000
wait 1
