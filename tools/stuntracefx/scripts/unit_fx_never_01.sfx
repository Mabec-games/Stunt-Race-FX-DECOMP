# unit_fx_never_01: unit tests (fx) for bank 01 Super FX code no play
# reaches (R11 = the STOP at $01:80E3; an entry that returns by pulling
# R15 finds that STOP as the word below R10):
# - FxObjectSpritePull 01:B147, the pull return after the sprite's size
#   test, from the start of a Novice race;
# - FxModelProjectEach 01:8BAE with the registers command $0C had in a
#   Novice Coupe race (speed_novice_coupe_08, ROM bank $0C), the stack
#   down to the end command's slot as in unit_model_commands_01;
# - FxModelFacesGatheredUV 01:91E7 and FxModelFacesOnScreenUV 01:9202
#   with the registers FxModelFaces had after gathering a face in that
#   race (speed_novice_coupe_07, ROM bank $0E);
# - FxText3D 01:B42F on the string "GAME_TM:" at $08:FE5E in colour 7
#   at the paths no other start reaches: the narrow loop's row below the
#   screen (size $90, y $0500), a row run to its end in each of its two
#   ways (size $0100 at depth $3000; size $C0 at depth $0400), the wide
#   loop's row below the screen (size $10, y $0500) and a scaled size
#   equal to the string's width (size $10 at depth $04F0);
# - FxText3DLeftColumn 01:B603 on a row's last bit (R12 = 1), one column
#   left of the screen and sixteen, with the string at its end and the
#   font row the last, so the walk ends with that row;
# - FxText3DRowEndNop 01:B67D at the last font row.
load build/stuntracefx/states/novice_coupe_race1.state
set 700244 E3,80
fx 01:B147 stop=80E3 r10=0246
wait 1
load build/stuntracefx/states/speed_novice_coupe_08.state
set 700244 E3,80,43,92
fx 01:8BAE stop=80E3 r10=0248 r0=0D84 r1=F100 r2=0000 r3=0F00 r4=02DC r5=0000 r6=7BE1 r7=7C2A r8=0100 r9=0370 r12=0000 r13=08FF r14=D9DF
wait 1
load build/stuntracefx/states/speed_novice_coupe_07.state
set 700244 E3,80,43,92
fx 01:91E7 stop=80E3 r10=0248 r0=0003 r1=0F00 r2=3DF0 r3=08AC r4=3DB0 r5=000A r6=1F0A r7=069A r8=08B8 r9=F56C r12=0000 r13=04F8 r14=8B15
wait 1
load build/stuntracefx/states/speed_novice_coupe_07.state
set 700244 E3,80,43,92
fx 01:9202 stop=80E3 r10=0248 r0=0003 r1=0F00 r2=3DF0 r3=08AC r4=3DB0 r5=000A r6=1F0A r7=069A r8=08B8 r9=F56C r12=0000 r13=04F8 r14=8B15
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
set 70001A 5E,FE,08,00
set 700026 00,00,00,05,00,04
set 7000C8 90,00
fx 01:B42F stop=80E3 r0=0007 r10=0244
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
set 70001A 5E,FE,08,00
set 700026 00,00,00,00,00,30
set 7000C8 00,01
fx 01:B42F stop=80E3 r0=0007 r10=0244
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
set 70001A 5E,FE,08,00
set 700026 00,00,00,00,00,04
set 7000C8 C0,00
fx 01:B42F stop=80E3 r0=0007 r10=0244
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
set 70001A 5E,FE,08,00
set 700026 00,00,00,05,00,04
set 7000C8 10,00
fx 01:B42F stop=80E3 r0=0007 r10=0244
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
set 70001A 5E,FE,08,00
