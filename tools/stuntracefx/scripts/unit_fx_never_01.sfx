set 7000C8 10,00
fx 01:B42F stop=80E3 r0=0007 r10=0244
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
set 70001A 5E,FE,08,00
set 700244 E3,80
fx 01:B603 stop=80E3 r1=FFFF r2=0036 r4=000F r5=FE66 r6=0000 r7=0000 r8=D20D r9=D20D r10=0246 r12=0001 r13=B5F5
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
set 70001A 5E,FE,08,00
