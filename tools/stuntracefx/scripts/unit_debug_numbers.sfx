# unit_debug_numbers: unit tests (call) from the start of a Novice race for
# the debug number printers of bank 03 no play runs (03:D499-D7C1): hex
# bytes and words, decimal bytes (one, two and three digits, 100 and 200
# up), signed bytes, signed decimal words (0, one digit, inner zeros, the
# largest, negative, $8000) and binary bytes, drawn at $70:6400 in the low
# and the high nibbles.
load build/stuntracefx/states/novice_coupe_race1.state
set 7E0046 00,64
set 7E0307 00,00
call 03:D4DE long a=0012 p=20 db=7E d=0000
wait 1
