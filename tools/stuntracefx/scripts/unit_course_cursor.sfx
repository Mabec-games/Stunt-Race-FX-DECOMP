# unit_course_cursor: the course cursor's handlers, which the game reaches
# only by jumps (CourseCursorStep's JMP (abs,X)), each as a call from
# the start of a Novice race with a move pressed in $0D1A:
# CourseCursorAt0 (02:ECB8) and CourseCursorAt2 (02:ECFA) with Right,
# CourseCursorAt1 (02:ECD9) and CourseCursorAt3 (02:ED1B) with Left,
# CourseCursorAt2Open (02:EC30) and CourseCursorAt3Open (02:EC73) with Up;
# and a step of CourseZoomInStep (02:ED3E).
load build/stuntracefx/states/novice_coupe_race1.state
set 7E0D1A 00,01
call 02:ECB8 p=30 db=00 d=0000
set 7E0D1A 00,02
call 02:ECD9 p=30 db=00 d=0000
set 7E0D1A 00,01
call 02:ECFA p=30 db=00 d=0000
set 7E0D1A 00,02
call 02:ED1B p=30 db=00 d=0000
set 7E0D1A 00,08
call 02:EC30 p=30 db=00 d=0000
set 7E0D1A 00,08
call 02:EC73 p=30 db=00 d=0000
call 02:ED3E p=30 db=00 d=0000
