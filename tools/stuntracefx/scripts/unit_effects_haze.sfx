# unit_effects_haze: unit tests (fx) of the Super FX haze effects, which no
# script turns on, from the start of a Novice race (R11 = the STOP at
# $01:80E3, R10 = the stack at $024C):
# - FxEffectsRun with bit 14 of $2736 set, the tied record at $1738 with
#   speed (+$4A) $40, at most 4 to start ($26EE) and every record free:
#   four start, age and are drawn (FxHazeSample, FxHazePlot);
# - FxEffectsRun with the speed negative (none start) and two records in
#   use, one about to run out; and with bit 14 clear (nothing done);
# - FxEffectsSpawn over sixteen records, every other one in use;
# - FxEffectsDraw with three records in use at the screen's middle and
#   corners, times 8, 4 and 1; FxHazePlot with nothing saved ($0340 = 0).
load build/stuntracefx/states/novice_coupe_race1.state
set 702736 00,40
set 70247A 38,17
set 701782 40,00
set 7026EE 04,00
set 702688 00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00
set 7026B8 00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00
fx 01:BF6D stop=80E3 r10=024C
wait 1
