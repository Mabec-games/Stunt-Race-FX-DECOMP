# unit_demo_runs_03: unit calls (call) from the start of a Novice race of
# the attract demo run (03:8683) on the two scripts the title's demo cycle
# never runs, both reached only through DemoRunThird: $1A57 = $159 (its
# commands 7 and 8, the window fade and its wait; about 2,700 frames) and
# $287 (command $0B, the wait for a button held, reached by frame 3,600:
# B given after it); then DemoRunThirdRest (03:866A), the demos $1FA
# (about 2,350 frames) and $287 in turn, B given once the second waits.
# The demo's frame counter $1A59 runs once per race frame, about one in
# five and a half of the machine's.
load build/stuntracefx/states/novice_coupe_race1.state
set 7E1A57 59,01
call 03:8683 long p=00 db=00 d=0000 frames=4000
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
set 7E1A57 87,02
call 03:8683 long p=00 db=00 d=0000 frames=6000 press=B@3700 press=B@3800
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
call 03:866A long p=00 db=03 d=0000 frames=9000 press=B@6100 press=B@6300
wait 1
