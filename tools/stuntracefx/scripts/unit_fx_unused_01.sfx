fx 01:BF32 stop=80E3 r0=00CD r1=0111 r2=001B r3=002A r4=002A r5=FFD3 r6=2FE7 r7=9101 r8=2AEC r9=00A9 r10=0246 r12=0001 r13=BD52
wait 1
