# unit_spc_race_paths: SPC700 unit calls (spccall) that take the race sound
# driver's paths no play reaches, from a Novice race's state: the voice
# commands no song uses, run through the dispatcher on voice 0 with their
# parameters at $01D0; the voice routines with the per-voice state that
# takes their rarer branches (pitch envelope at note-on, vibrato fade,
# tremolo at full depth, inverted pan, the fades ending); every port 1
# command; and the game side's rarer branches with the RAM bytes that
# decide them.
load build/stuntracefx/states/novice_coupe_race1.state
spcset 0030 D0,01
spcset 01D0 08
spccall 0BA2 a=F0 x=00
wait 10
load build/stuntracefx/states/novice_coupe_race1.state
spcset 0030 D0,01
spcset 01D0 10,40
spccall 0BA2 a=E6 x=00
wait 10
