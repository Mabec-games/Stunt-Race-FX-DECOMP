# unit_debug_handlers: unit tests (call) from the start of a Novice race: the
# three debug error messages, and the linked object's handler by state (8
# with each record kind, with and without the record words, and another
# state with $19ED at 8).
load build/stuntracefx/states/novice_coupe_race1.state
set 7026F0 01,00
set 701090 01,00
set 702650 01,00
call 08:FEB4 long p=20 db=00 d=0000
wait 1
