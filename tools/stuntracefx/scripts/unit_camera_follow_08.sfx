# unit_camera_follow_08: the replay camera's car-following shots of bank
# $08 (08:95A0-9A4E), as calls on object 1 ($2001) of a Novice race's
# state made a director (camera link +$4F = $1A64, car +$06 = itself):
# each shot and frame once; the follower with no contacts, a contact and
# a contact with flags bits 0-1 (contact flags 3-4); the counting frames
# with +$48 at 0, 1 and 5; the lift-off with the car high and low; the
# track shot with and without its cue (+$25 bit 0).
load build/stuntracefx/states/novice_coupe_race1.state
set 7E2007 01,00
set 7E2050 64,1A
call 08:95A0 long x=0001 p=20 db=7E d=0000
