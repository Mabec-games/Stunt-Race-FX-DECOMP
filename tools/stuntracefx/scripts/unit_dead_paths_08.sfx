# unit_dead_paths_08: bank 08 paths no game state reaches, as calls on
# object 1 ($2001) from a Novice race's state: the sign stores
# ObjectPieceSpray 08:D460 and ObjectMoveForward 08:B34B never take (their
# XSign/YSign/ZSign entries, called directly), ObjectMoveForward's early
# return (X = 0), and ObjectLampAnimate 08:E51E with its count +$4B at
# $FF (the word 0 of each look table), at 1-4 on the $1C path.
load build/stuntracefx/states/novice_coupe_race1.state
set 7E2007 01,00
set 7E2050 64,1A
set 7E2028 01,00
set 7E1F4C E0,FF
call 08:D4B9 long x=0001 y=0001 p=20 db=7E d=0000
