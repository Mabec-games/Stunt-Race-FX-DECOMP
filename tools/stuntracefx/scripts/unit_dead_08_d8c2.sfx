# unit_dead_08_d8c2: unit tests of bank $08 code nothing calls or jumps to
# (08:D8C2-DC12), on object 1 of a Novice race:
# - GsuRecordPositionFromObject 08:D8C2 with the object's record and with
#   none (+$22 cleared);
# - the eight-object group 08:D8E4 (a JSR routine) with free objects, with
#   one (the free list cut at $7E:4FDB) and with none (the count $0CEE at
#   its limit $2E);
# - its handler's start 08:DB7A, its step 08:DB90 and the player check
#   08:DBD9: already set (+$25 bit 0), the player (here object 2, $0063,
#   as $0346) level with it, $4000 away along +$10, and $100 behind with
#   its +$4C already 5.
load build/stuntracefx/states/novice_coupe_race1.state
call 08:D8C2 long x=0001 p=20 db=7E d=0000
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
set 7E2023 00,00
call 08:D8C2 long x=0001 p=20 db=7E d=0000
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
call 08:D8E4 x=0001 y=0001 p=20 db=7E d=0000
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
set 7E4FDB 00,00
call 08:D8E4 x=0001 y=0001 p=20 db=7E d=0000
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
set 7E0CEE 2E
call 08:D8E4 x=0001 y=0001 p=20 db=7E d=0000
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
call 08:DB7A long x=0001 p=20 db=7E d=0000
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
set 7E2027 63,00
call 08:DB90 long x=0001 p=20 db=7E d=0000
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
set 7E2026 01
call 08:DBD9 long x=0001 p=20 db=7E d=0000
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
set 7E0346 63,00
set 7E2026 00
set 7E2011 00,10
set 7E2073 00,10
call 08:DBD9 long x=0001 p=20 db=7E d=0000
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
set 7E0346 63,00
set 7E2026 00
set 7E2011 00,10
set 7E2073 00,50
call 08:DBD9 long x=0001 p=20 db=7E d=0000
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
set 7E0346 63,00
set 7E2026 00
set 7E2011 00,10
set 7E2073 00,0F
set 7E20AF 05
call 08:DBD9 long x=0001 p=20 db=7E d=0000
wait 1
