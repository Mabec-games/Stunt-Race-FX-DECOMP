# unit_draw_list: unit tests (fx) of FxDrawList from the start of a Novice
# race (R11 = the STOP at $01:80E3, R10 = the stack at $024C):
# - an empty list ($005C = $08AA): returns at once;
# - one list of each shape: a flat polygon of 4 vertices, a flat one a row
#   high (drawn as one row), a line along x, a line along y back up, and a
#   textured polygon of 4 vertices (texture in ROM bank $14 at $8000, mask
#   $1F3F), ending at $0906;
# - FxPolygonClipScreen on a triangle at $7E40 (unused Super FX RAM)
#   wholly left of the screen (outcode 4) and one wholly right of it
#   (outcode 8): nothing is left after that edge (R0 = 0); and on a line
#   (R0 = 2, FxClipLine) wholly left, then wholly right;
# - FxPolygonGather on a triangle all behind the view: every one of the
#   256 points at $0340 at z = -$100 (the index bytes at R14 can be any),
#   the object at 0: nothing is left after the near clip (R0 = 0).
load build/stuntracefx/states/novice_coupe_race1.state
set 70005C AA,08
fx 01:A931 stop=80E3 r10=024C
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
