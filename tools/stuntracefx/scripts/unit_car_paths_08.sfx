# unit_car_paths_08: paths of bank $08's car code that no play takes, as
# calls on object 1 ($2001, the player's car of a Novice race's state,
# record $1CD8, its chain $1B90-$1C86): PlayerCarEvents with the record's
# landing speed +$94 at $100, $300 and $400 (sounds $54-$56);
# ObjectChildrenSpawn with no record, with the chain's first record
# marked (+$46 bit 9), and with no free object; ObjectChildFlying with the parent's record
# +$64 bit 4 (released).
load build/stuntracefx/states/novice_coupe_race1.state
set 701D6C 00,01
call 08:C124 long x=0001 p=20 db=7E d=0000
load build/stuntracefx/states/novice_coupe_race1.state
set 701D6C 00,03
call 08:C124 long x=0001 p=20 db=7E d=0000
load build/stuntracefx/states/novice_coupe_race1.state
set 701D6C 00,04
call 08:C124 long x=0001 p=20 db=7E d=0000
load build/stuntracefx/states/novice_coupe_race1.state
set 7E2023 00,00
call 08:BA57 long x=0001 p=20 db=7E d=0000
load build/stuntracefx/states/novice_coupe_race1.state
set 701BD6 1A,02
call 08:BA57 long x=0001 p=20 db=7E d=0000
load build/stuntracefx/states/novice_coupe_race1.state
set 7E0CEE 2E
call 08:BA57 long x=0001 p=20 db=7E d=0000
load build/stuntracefx/states/novice_coupe_race1.state
set 7E2007 01,00
set 7E2026 10
set 7E204C 00
set 701D3C 10,00
call 08:BBE2 long x=0001 p=20 db=7E d=0000
