# unit_uncalled: unit tests (call) from the start of a Novice race for
# routines the game reaches only by jumps or not at all in the scripts:
# KeepRegisters, the bob 1 window and its bands, the $FFD5 bands,
# TimesKeepAndAdvance, and the trail, attached and sparkle object handlers
# (object $2F79 with its parent, +$27 and +$06, the player's car $0001;
# the sparkle step with its count +$48 at 0, so it is released), and
# ObjectReleaseLong (reached only by a JML) on that object.
load build/stuntracefx/states/novice_coupe_race1.state
call 7E:F217 long p=00 db=00 d=0000
wait 1
