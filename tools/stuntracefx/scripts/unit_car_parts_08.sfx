# unit_car_parts_08: the car parts of bank $08 (08:AB71-B078) and the car
# set-ups 08:B1BA/B1C7/B1D4, as calls on object 1 ($2001, the player's car
# of a Novice race's state) with its parent +$06 = itself: the part offset
# 08:AB71 by JSR with spin bytes +$48-$4A of each sign, the detached part
# on each +$4B count, the hit part with a record and without (the first
# record pool emptied at $70:1098), its frames on +$25 bits, +$4B and the
# life +$27, a car's contact staged in Super FX RAM as in unit_gates_09 or
# a record with no contacts whose summary has bit 7 ($70:26F2 bit 5), the
# player cars' set-ups (HUD mode, the bare object's handler $8E2A) and
# frames (the record's +$1C bit 1).
load build/stuntracefx/states/novice_coupe_race1.state
set 7E2049 EE,F3
set 7E204B F0
call 08:AB71 x=0001 y=0001 p=20 db=7E d=0000
