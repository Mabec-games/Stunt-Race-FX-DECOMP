# unit_switches_09: the switches and switch lamps of bank $09 no course in
# the scripts places (09:B133-B30A), as calls on object 1 ($2001) of a
# Novice race: each set-up and record set-up once (each falls into its
# frame); the lamps' frames with their switch byte ($19E9, $19EA) clear
# and set; the switches' frames with a car's contact staged as
# unit_gates_09 does (record $5000, its contact list at $5100 touching
# record $5200, contact word 1 or 2 picking the flags), with +$25 bit 0
# clear and set, and with no contact list.
load build/stuntracefx/states/novice_coupe_race1.state
call 09:B133 long x=0001 p=20 db=7E d=0000
wait 1
