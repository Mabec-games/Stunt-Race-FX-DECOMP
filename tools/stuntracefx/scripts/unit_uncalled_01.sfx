set 7001C4 01,00
fx 01:AECA stop=80E3
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
set 7001C4 00,00
fx 01:AEE1 stop=80E3
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
set 7001C4 01,00
fx 01:AEE1 stop=80E3
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
set 7000AA 00,00,03,00
set 7001D2 40,00,30,00
