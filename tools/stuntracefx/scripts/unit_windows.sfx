# unit_windows: unit tests (call) from the start of a Novice race: the
# oscillator at bit 7 and level 0, bob 1's step, the sweep, bob event 2's
# start through a built link chain, both bob windows with two players, and
# the oscillator window with two players.
load build/stuntracefx/states/novice_coupe_race1.state
set 7E1A11 80
call 7E:DD43 x=0000 p=30 db=7E d=0000
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
set 7E1A11 10
call 7E:DD43 x=0000 p=30 db=7E d=0000
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
call 7E:DF61 x=0001 p=30 db=7E d=0000
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
set 7E19D8 00
set 7E19BC 00
set 7E0DA5 10
call 7E:D311 long p=00 db=00 d=0000
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
set 7E1A1F 01
set 7E1A23 09
call 7E:DF61 x=0001 p=30 db=7E d=0000
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
set 7E034A 00,01
set 7E214F 00,02
set 7E224F A0,1F
set 7E1FA0 00,40
set 7E1A26 01,00
set 7E0DA6 00
call 7E:D3DD p=00 db=7E d=0000
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
set 7E19D8 00
set 7E19BC 00
set 7E0DA4 80
set 7E0DA6 80
set 7E0D62 01
call 7E:D33A long p=00 db=00 d=0000
wait 1
load build/stuntracefx/states/novice_coupe_race1.state
