# unit_math_03: unit tests (call) from the start of a Novice race for the
# bank 03 fixed scalings no play runs (03:CC29-CC7F: positive, negative,
# odd and extreme values) and the approach steps no play runs or runs on
# one path only (03:CDC1 CE75 CF7A on the word at $3E, 03:D07C D0BD D105
# D154 on its byte): arrived, raised to the minimum up and down, far up,
# far down with rounding toward zero, and the add that overflows.
load build/stuntracefx/states/novice_coupe_race1.state
set 7E003E 55,AA
call 03:CC29 long a=1234 p=00 db=00 d=0000
wait 1
