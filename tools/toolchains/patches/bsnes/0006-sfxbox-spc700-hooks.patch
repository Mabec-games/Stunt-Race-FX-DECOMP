+//SPC700 state and actions for the sfxbox harness (see emulator/sfxbox.hpp).
+extern "C" void sfxbox_smp_get(struct SfxboxSmpState* o) {
+  using namespace SuperFamicom;
+  o->pc = smp.r.pc.w; o->a = smp.r.ya.byte.l; o->y = smp.r.ya.byte.h; o->x = smp.r.x; o->s = smp.r.s; o->p = (uint8)smp.r.p;
+}
+
+extern "C" void sfxbox_smp_put(const struct SfxboxSmpState* i) {
+  using namespace SuperFamicom;
+  smp.r.pc.w = i->pc; smp.r.ya.byte.l = i->a; smp.r.ya.byte.h = i->y; smp.r.x = i->x; smp.r.s = i->s; smp.r.p = i->p;
+}
+
+extern "C" void sfxbox_smp_time(uint32_t clocks) {
+  using namespace SuperFamicom;
+  smp.sfxboxTime(clocks);
+}
+
+extern "C" uint8_t sfxbox_smp_bus(int write, uint16_t addr, uint8_t data) {
+  using namespace SuperFamicom;
+  return smp.sfxboxBus(write, addr, data);
+}
