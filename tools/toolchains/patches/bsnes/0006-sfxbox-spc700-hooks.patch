   if(r.wait) return instructionWait();
   if(r.stop) return instructionStop();
   sfxbox_smp_insn(r.pc.w);
+  if(sfxbox_smp_hooked) {
+    uint16 pc = r.pc.w;
+    if(sfxbox_smp_cb.insn) sfxbox_smp_cb.insn(pc, sfxbox_smp_fetch_end, readRAM(pc));
+    if(sfxbox_smp_exec && sfxbox_smp_exec(pc, sfxbox_smp_fetch_end)) return;
+  }
   instruction();
 }
 
