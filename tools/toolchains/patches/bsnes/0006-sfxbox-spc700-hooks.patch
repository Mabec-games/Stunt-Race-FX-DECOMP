     uint8 data = readRAM(address);
     if((address & 0xfff0) == 0x00f0) data = readIO(address);
     wait(address, 1);
+    if(sfxbox_smp_cb.mem && !sfxbox_smp_fetching) sfxbox_smp_cb.mem(0, address, data);  //I/O: never the PC dummy
     return data;
   } else {
     wait(address, 0);
     uint8 data = readRAM(address);
     if((address & 0xfff0) == 0x00f0) data = readIO(address);
-    if(!sfxbox_smp_fetching) sfxbox_smp_read(address);
+    //not an instruction fetch, nor the read(PC) an implied-operand instruction makes of the byte after it
+    if(!sfxbox_smp_fetching && address != sfxbox_smp_fetch_end) { sfxbox_smp_read(address); if(sfxbox_smp_cb.mem) sfxbox_smp_cb.mem(0, address, data); }
     return data;
   }
 }
 
 auto SMP::write(uint16 address, uint8 data) -> void {
   wait(address);
+  if(sfxbox_smp_cb.mem) sfxbox_smp_cb.mem(1, address, data);
   writeRAM(address, data);  //even IO writes affect underlying RAM
   if((address & 0xfff0) == 0x00f0) writeIO(address, data);
 }
