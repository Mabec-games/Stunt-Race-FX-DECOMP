+// ---- SPC700 checks ----
+// Events from the SPC700 for the harness: each instruction about to run
+// (its address, the address after the last byte the previous one fetched,
+// its opcode), each data access with its value (APU RAM or I/O; not
+// instruction fetches), each clock step.
+struct SfxboxSmpCallbacks {
+  void (*insn)(uint16_t pc, uint16_t prev_end, uint8_t opcode);
+  void (*mem)(int write, uint16_t addr, uint8_t data);
+  void (*step)(uint32_t clocks);
+};
+extern SfxboxSmpCallbacks sfxbox_smp_cb;
+extern int sfxbox_smp_hooked;
+extern uint16_t sfxbox_smp_fetch_end;
+// Run in place of the instruction at pc (1), or let it run (0).
+extern int (*sfxbox_smp_exec)(uint16_t pc, uint16_t prev_end);
+struct SfxboxSmpState { uint16_t pc; uint8_t a, x, y, s, p; };
+void sfxbox_smp_get(struct SfxboxSmpState* out);
+void sfxbox_smp_put(const struct SfxboxSmpState* in);
+// Spend SPC700 clocks (and timer clocks alike) with nothing else happening.
+void sfxbox_smp_time(uint32_t clocks);
+// One SPC700 data access made now, without time (read when write == 0).
+uint8_t sfxbox_smp_bus(int write, uint16_t addr, uint8_t data);
 void sfxbox_gsu_operand(uint32_t addr);
 void sfxbox_gsu_data(uint32_t addr);
 // Per-access events for the call oracle (kind: 0 S-CPU write, 2 DMA write).
