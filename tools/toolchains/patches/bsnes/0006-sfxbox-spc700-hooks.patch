 //Sony CXP1100Q-1
 
 struct SMP : Processor::SPC700, Thread {
+  //sfxbox harness: time and accesses with nothing else happening
+  auto sfxboxTime(uint clocks) -> void { step(clocks); stepTimers(clocks); }
+  auto sfxboxBus(bool write, uint16 address, uint8 data) -> uint8 {
+    if(write) { writeRAM(address, data); if((address & 0xfff0) == 0x00f0) writeIO(address, data); return data; }
+    uint8 value = readRAM(address);
+    if((address & 0xfff0) == 0x00f0) value = readIO(address);
+    return value;
+  }
   inline auto synchronizing() const -> bool override { return scheduler.synchronizing(); }
 
