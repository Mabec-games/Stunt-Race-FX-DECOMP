+// The harness installs its Super FX callbacks and its run-in-place hook here.
+extern "C" RETRO_API void sfxbox_gsu_set_callbacks(const SfxboxGsuCallbacks* cb, int (*exec)(uint32_t, uint32_t)) {
+  sfxbox_gsu_cb = cb ? *cb : SfxboxGsuCallbacks{};
+  sfxbox_gsu_exec = exec;
