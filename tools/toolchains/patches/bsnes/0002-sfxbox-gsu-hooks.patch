 // OAM 544, CGRAM 512, APU RAM 64K, in that order.
 enum { SFXBOX_SNAPSHOT_SIZE = 0x20000 + 0x10000 + 0x10000 + 544 + 512 + 0x10000 };
 void sfxbox_core_snapshot(uint8_t* out);
+
+// ---- Super FX ----
+// Events from the Super FX for the harness (target-libretro/sfxbox.cpp keeps
+// the callbacks): each instruction about to run (its address, the address
+// after the last byte the previous one fetched, its opcode), each clock
+// step, each game pak RAM access, each code cache line filled and each cache
+// flush with the cache base it leaves.
+struct SfxboxGsuCallbacks {
+  void (*insn)(uint32_t pc, uint32_t prev_end, uint8_t opcode);
+  void (*step)(uint32_t clocks);
+  void (*ram)(int write, uint32_t addr, uint8_t data);
+  void (*cache)(int kind, uint32_t value);
+};
+extern SfxboxGsuCallbacks sfxbox_gsu_cb;
+extern int sfxbox_gsu_hooked;
+// Run in place of the instruction at pc (1), or let it run (0).
+extern int (*sfxbox_gsu_exec)(uint32_t pc, uint32_t prev_end);
+// The Super FX's state, read and written whole by the harness.
+struct SfxboxGsuPixelCache { uint16_t offset; uint8_t bitpend; uint8_t data[8]; };
+struct SfxboxGsuState {
+  uint16_t r[16];
+  uint16_t sfr;
+  uint8_t pbr, rombr, rambr, scbr, scmr, colr, por, cfgr, clsr, pipeline, sreg, dreg;
+  uint16_t cbr, ramaddr;
+  uint8_t romcl, romdr, ramcl, ramdr;
+  uint16_t ramar;
+  uint32_t pipe_addr, last_byte;
+  struct SfxboxGsuPixelCache pixel[2];
+};
+void sfxbox_gsu_get(struct SfxboxGsuState* out);
+void sfxbox_gsu_put(const struct SfxboxGsuState* in);
+// Spend clocks on the Super FX's timeline with nothing else happening.
+void sfxbox_gsu_time(uint32_t clocks);
+// One access on the Super FX's bus, made now (read when write == 0).
+uint8_t sfxbox_gsu_bus(int write, uint32_t addr, uint8_t data);
+// Fill code cache line `line` as an instruction fetch would, without time.
+void sfxbox_gsu_fill(uint32_t line);
+// Set the cache base and invalidate the cache, as CACHE and LJMP do.
+void sfxbox_gsu_flush(uint32_t cbr);
+// The code byte at addr as the Super FX would fetch it now (cache or bus), without time.
+uint8_t sfxbox_gsu_fetch(uint16_t addr);
 }
