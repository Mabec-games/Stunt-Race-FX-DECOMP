+//Super FX state and actions for the sfxbox harness (see emulator/sfxbox.hpp).
+extern "C" void sfxbox_gsu_get(struct SfxboxGsuState* o) {
+  using namespace SuperFamicom;
+  auto& r = superfx.regs;
+  for(uint n : range(16)) o->r[n] = r.r[n].data;
+  o->sfr = r.sfr.data; o->pbr = r.pbr; o->rombr = r.rombr; o->rambr = r.rambr; o->scbr = r.scbr;
+  o->scmr = (uint)r.scmr; o->colr = r.colr; o->por = (uint)r.por; o->cfgr = (uint)r.cfgr; o->clsr = r.clsr;
+  o->pipeline = r.pipeline; o->sreg = r.sreg; o->dreg = r.dreg; o->cbr = r.cbr; o->ramaddr = r.ramaddr;
+  o->romcl = r.romcl; o->romdr = r.romdr; o->ramcl = r.ramcl; o->ramdr = r.ramdr; o->ramar = r.ramar;
+  o->pipe_addr = superfx.sfxboxPipeAddr; o->last_byte = superfx.sfxboxLastByte;
+  for(uint n : range(2)) {
+    o->pixel[n].offset = superfx.pixelcache[n].offset; o->pixel[n].bitpend = superfx.pixelcache[n].bitpend;
+    for(uint k : range(8)) o->pixel[n].data[k] = superfx.pixelcache[n].data[k];
+  }
+}
+
+extern "C" void sfxbox_gsu_put(const struct SfxboxGsuState* i) {
+  using namespace SuperFamicom;
+  auto& r = superfx.regs;
+  for(uint n : range(16)) { r.r[n].data = i->r[n]; r.r[n].modified = false; }
+  r.sfr.data = i->sfr; r.pbr = i->pbr; r.rombr = i->rombr; r.rambr = i->rambr; r.scbr = i->scbr;
+  r.scmr = i->scmr; r.colr = i->colr; r.por = i->por; r.cfgr = i->cfgr; r.clsr = i->clsr;
+  r.pipeline = i->pipeline; r.sreg = i->sreg; r.dreg = i->dreg; r.cbr = i->cbr; r.ramaddr = i->ramaddr;
+  r.romcl = i->romcl; r.romdr = i->romdr; r.ramcl = i->ramcl; r.ramdr = i->ramdr; r.ramar = i->ramar;
+  superfx.sfxboxPipeAddr = i->pipe_addr; superfx.sfxboxLastByte = i->last_byte;
+  for(uint n : range(2)) {
+    superfx.pixelcache[n].offset = i->pixel[n].offset; superfx.pixelcache[n].bitpend = i->pixel[n].bitpend;
+    for(uint k : range(8)) superfx.pixelcache[n].data[k] = i->pixel[n].data[k];
+  }
+}
+
+extern "C" void sfxbox_gsu_time(uint32_t clocks) {
+  using namespace SuperFamicom;
+  superfx.clock += clocks * (uint64_t)cpu.frequency;
+  superfx.synchronizeCPU();
+}
+
+extern "C" uint8_t sfxbox_gsu_bus(int write, uint32_t addr, uint8_t data) {
+  using namespace SuperFamicom;
+  if(write) { superfx.write(addr, data); return data; }
+  return superfx.read(addr);
+}
+
+extern "C" void sfxbox_gsu_fill(uint32_t line) {
+  using namespace SuperFamicom;
+  uint dp = (line & 31) << 4;
+  uint sp = (superfx.regs.pbr << 16) + ((superfx.regs.cbr + dp) & 0xfff0);
+  for(uint n : range(16)) superfx.cache.buffer[dp++] = superfx.read(sp++);
+  superfx.cache.valid[line & 31] = true;
+}
+
+extern "C" void sfxbox_gsu_flush(uint32_t cbr) {
+  using namespace SuperFamicom;
+  superfx.regs.cbr = cbr;
+  for(uint n : range(32)) superfx.cache.valid[n] = false;
+}
+
+extern "C" uint8_t sfxbox_gsu_fetch(uint16_t addr) {
+  using namespace SuperFamicom;
+  uint16 offset = addr - superfx.regs.cbr;
+  if(offset < 512 && superfx.cache.valid[offset >> 4]) return superfx.cache.buffer[offset];
+  return superfx.read(superfx.regs.pbr << 16 | addr);
+}
