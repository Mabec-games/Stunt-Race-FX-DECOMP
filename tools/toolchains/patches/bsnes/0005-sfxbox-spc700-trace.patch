+// SPC700, by APU RAM address: 1 opcode fetched, 2 operand fetched, 4 read
+// as data, 8 fetched with more than two different values; the value
+// fetched first; then the same flags and value for a second, different
+// value fetched there (the RAM was loaded again between: another version
+// of the code). Folded back onto the uploaded ROM blocks by
+// tools/stuntracefx (their bytes match the values).
+static uint8_t sfxboxSpcExec[0x10000], sfxboxSpcExec2[0x10000];
+static uint8_t sfxboxSpcByte[0x10000], sfxboxSpcByte2[0x10000];
+static uint16_t sfxboxSmpPrev = 0, sfxboxSmpEnd = 0;
+static bool sfxboxSmpHavePrev = false;
+static uint8_t sfxboxSmpPrevOp = 0;
+static int sfxboxSmpFirst = 0;
+// key: opcode(8) | from(16) | to(16) -> count, APU addresses
+static std::unordered_map<uint64_t, uint32_t> sfxboxSpcEdges;
+
 static inline void sfxboxEdge(int gsu, uint32_t from, uint32_t to, uint32_t kind) {
   uint64_t key = (uint64_t)gsu << 63 | (uint64_t)(kind & 0x1ff) << 48 | (uint64_t)(from & 0xffffff) << 24 | (to & 0xffffff);
   sfxboxEdges[key]++;
@@ -130,6 +146,38 @@ extern "C" void sfxbox_gsu_data(uint32_t addr) {
   if(o >= 0) sfxboxRom[o] |= SFXBOX_GSU_DATA;
 }
 
+// ---- SPC700 ----
+
+extern "C" void sfxbox_smp_insn(uint16_t pc) {
+  if(!sfxboxRom) return;
+  if(sfxboxSmpHavePrev && pc != sfxboxSmpEnd)
+    sfxboxSpcEdges[(uint64_t)sfxboxSmpPrevOp << 32 | (uint64_t)sfxboxSmpPrev << 16 | pc]++;
+  sfxboxSmpPrev = pc;
+  sfxboxSmpHavePrev = true;
+  sfxboxSmpFirst = 1;
+}
+
+extern "C" void sfxbox_smp_fetch(uint16_t addr, uint8_t data) {
+  if(!sfxboxRom) return;
+  int first = sfxboxSmpFirst;
+  sfxboxSmpFirst = 0;
+  uint8_t bit = first ? 1 : 2;
+  if(!(sfxboxSpcExec[addr] & 3) || sfxboxSpcByte[addr] == data) {
+    sfxboxSpcByte[addr] = data;
+    sfxboxSpcExec[addr] |= bit;
+  } else if(!(sfxboxSpcExec2[addr] & 3) || sfxboxSpcByte2[addr] == data) {
+    sfxboxSpcByte2[addr] = data;
+    sfxboxSpcExec2[addr] |= bit;
+  } else sfxboxSpcExec[addr] |= 8;
+  if(first) sfxboxSmpPrevOp = data;
+  sfxboxSmpEnd = (uint16_t)(addr + 1);
+}
+
+extern "C" void sfxbox_smp_read(uint16_t addr) {
+  if(!sfxboxRom) return;
+  sfxboxSpcExec[addr] |= 4;
+}
