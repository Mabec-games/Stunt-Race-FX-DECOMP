@@ -29,7 +29,7 @@ auto SMP::read(uint16 address) -> uint8 {
     uint8 data = readRAM(address);
     if((address & 0xfff0) == 0x00f0) data = readIO(address);
     //not an instruction fetch, nor the read(PC) an implied-operand instruction makes of the byte after it
-    if(!sfxbox_smp_fetching && !sfxbox_smp_dummy) { sfxbox_smp_read(address); if(sfxbox_smp_cb.mem) sfxbox_smp_cb.mem(0, address, data); }
