diff --git a/bsnes/target-libretro/sfxbox.cpp b/bsnes/target-libretro/sfxbox.cpp
new file mode 100644
index 0000000..ec4a245
--- /dev/null
+++ b/bsnes/target-libretro/sfxbox.cpp
@@ -0,0 +1,167 @@
+// sfxbox: trace maps and dispatch hooks, exported for the harness.
+// Kept separate from the libretro frontend; libretro.cpp includes it.
+#include <emulator/sfxbox.hpp>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unordered_map>
+
+extern "C" {
+int sfxbox_cpu_who = SFXBOX_WHO_DATA;
+int sfxbox_cpu_first = 0;
+uint32_t sfxbox_cpu_fetch_end = 0;
+uint8_t sfxbox_cpu_opcode = 0;
+int sfxbox_cpu_irq = 0;
+int (*sfxbox_cpu_exec)(uint32_t pc) = nullptr;
+}
+
+extern "C" uint8_t* sfxbox_core_memory(int which, size_t* size);  // sfc/coprocessor/superfx/superfx.cpp
+static uint8_t* sfxboxRomData() { size_t n; return sfxbox_core_memory(2, &n); }
+
+struct SfxboxCallbacks {
+  void (*insn)(uint32_t pc);
+  void (*write)(uint32_t addr, uint8_t data, int kind);
+  void (*read)(uint32_t addr, uint8_t data);
+  void (*interrupt)(uint32_t resume_pc, uint16_t s);
+};
+static SfxboxCallbacks sfxboxCb = {};
+
+static uint16_t* sfxboxRom = nullptr;
+static uint32_t sfxboxRomSize = 0;
+static uint16_t sfxboxCpuFlags = 0;
+static uint8_t sfxboxWramExec[0x20000];
+static uint8_t sfxboxGsuRamExec[0x20000];
+static uint32_t sfxboxCpuPrev = ~0u;
+static uint32_t sfxboxGsuPrev = ~0u, sfxboxGsuEnd = ~0u;
+static uint8_t sfxboxGsuPrevOp = 0;
+// key: cpu(1) | kind(9) | from(24) | to(24) -> count
+static std::unordered_map<uint64_t, uint32_t> sfxboxEdges;
+
+static inline void sfxboxEdge(int gsu, uint32_t from, uint32_t to, uint32_t kind) {
+  uint64_t key = (uint64_t)gsu << 63 | (uint64_t)(kind & 0x1ff) << 48 | (uint64_t)(from & 0xffffff) << 24 | (to & 0xffffff);
+  sfxboxEdges[key]++;
+}
+
+extern "C" void sfxbox_cpu_rom(uint32_t offset) {
+  if(!sfxboxRom) return;
+  offset %= sfxboxRomSize;
+  switch(sfxbox_cpu_who) {
+  case SFXBOX_WHO_OP: sfxboxRom[offset] |= SFXBOX_CPU_OP | sfxboxCpuFlags; break;
+  case SFXBOX_WHO_OPND: sfxboxRom[offset] |= SFXBOX_CPU_OPND; break;
+  case SFXBOX_WHO_DMA: sfxboxRom[offset] |= SFXBOX_DMA; break;
+  case SFXBOX_WHO_DATA: sfxboxRom[offset] |= SFXBOX_CPU_DATA; break;
+  default: break;
+  }
+}
+
+extern "C" void sfxbox_cpu_insn(uint32_t pc, int m, int x, int e, int db, int d) {
+  (void)db; (void)d;
+  if(sfxboxRom) {
+    if(sfxboxCpuPrev != ~0u && pc != sfxbox_cpu_fetch_end)
+      sfxboxEdge(0, sfxboxCpuPrev, pc, sfxbox_cpu_irq ? 0x100 : sfxbox_cpu_opcode);
+    uint32_t bank = pc >> 16 & 0xff, addr = pc & 0xffff;
+    if(bank == 0x7e || bank == 0x7f) sfxboxWramExec[(bank & 1) << 16 | addr] = 1;
+    else if((bank & 0x40) == 0 && addr < 0x2000) sfxboxWramExec[addr] = 1;
+  }
+  sfxbox_cpu_irq = 0;
+  sfxboxCpuPrev = pc;
+  if(sfxboxCb.insn) sfxboxCb.insn(pc);
+  sfxboxCpuFlags = (m ? SFXBOX_M8 : SFXBOX_M16) | (x ? SFXBOX_X8 : SFXBOX_X16) | (e ? SFXBOX_EMU : 0);
+  sfxbox_cpu_first = 1;
+}
+
+// GSU address -> ROM offset, or -1 for RAM (mirrors SuperFX::read).
+static inline int64_t sfxboxGsuRom(uint32_t addr) {
+  uint32_t bank = addr >> 16 & 0xff;
+  if(bank <= 0x3f) return ((bank & 0x3f) << 15 | (addr & 0x7fff)) % sfxboxRomSize;
+  if(bank <= 0x5f) return (addr & 0x3fffff) % sfxboxRomSize;
+  return -1;
+}
+
+extern "C" void sfxbox_gsu_insn(uint32_t addr) {
+  if(!sfxboxRom) return;
+  int64_t o = sfxboxGsuRom(addr);
+  uint8_t op = 0;
+  if(o >= 0) { sfxboxRom[o] |= SFXBOX_GSU_OP; op = sfxboxRomData()[o]; }
+  else { sfxboxGsuRamExec[addr & 0x1ffff] = 1; }
+  if(sfxboxGsuPrev != ~0u && addr != sfxboxGsuEnd) sfxboxEdge(1, sfxboxGsuPrev, addr, sfxboxGsuPrevOp);
+  sfxboxGsuPrev = addr;
+  sfxboxGsuPrevOp = op;
+  sfxboxGsuEnd = (addr & 0xff0000) | ((addr + 1) & 0xffff);
+}
+
+extern "C" void sfxbox_gsu_operand(uint32_t addr) {
+  if(!sfxboxRom) return;
+  int64_t o = sfxboxGsuRom(addr);
+  if(o >= 0) sfxboxRom[o] |= SFXBOX_GSU_OPND;
+  sfxboxGsuEnd = (addr & 0xff0000) | ((addr + 1) & 0xffff);
+}
+
+extern "C" void sfxbox_gsu_data(uint32_t addr) {
+  if(!sfxboxRom) return;
+  int64_t o = sfxboxGsuRom(addr);
+  if(o >= 0) sfxboxRom[o] |= SFXBOX_GSU_DATA;
+}
+
+// ---- call-oracle events, forwarded to the harness ----
+
+
+extern "C" RETRO_API void sfxbox_set_callbacks(const SfxboxCallbacks* cb) {
+  sfxboxCb = cb ? *cb : SfxboxCallbacks{};
+}
+
+extern "C" void sfxbox_cpu_write(uint32_t addr, uint8_t data, int kind) {
+  if(sfxboxCb.write) sfxboxCb.write(addr, data, kind);
+}
+
+extern "C" void sfxbox_cpu_read(uint32_t addr, uint8_t data) {
+  if(sfxboxCb.read) sfxboxCb.read(addr, data);
+}
+
+extern "C" void sfxbox_cpu_interrupt(uint32_t resume_pc, uint16_t s) {
+  if(sfxboxCb.interrupt) sfxboxCb.interrupt(resume_pc, s);
+}
+
+extern "C" RETRO_API void sfxbox_regs(struct SfxboxRegs* out) { sfxbox_core_regs(out); }
+
+// ---- exported to the harness ----
+
+extern "C" RETRO_API void sfxbox_trace_begin() {
+  { size_t n; sfxbox_core_memory(2, &n); sfxboxRomSize = n; }
+  free(sfxboxRom);
+  sfxboxRom = (uint16_t*)calloc(sfxboxRomSize ? sfxboxRomSize : 1, sizeof(uint16_t));
+  memset(sfxboxWramExec, 0, sizeof sfxboxWramExec);
+  memset(sfxboxGsuRamExec, 0, sizeof sfxboxGsuRamExec);
+  sfxboxEdges.clear();
+  sfxboxCpuPrev = sfxboxGsuPrev = sfxboxGsuEnd = ~0u;
+}
+
+extern "C" RETRO_API int sfxbox_trace_write(const char* dir) {
+  if(!sfxboxRom) return -1;
+  char path[4096];
+  snprintf(path, sizeof path, "%s/rommap.bin", dir);
+  FILE* f = fopen(path, "wb"); if(!f) return -1;
+  fwrite(sfxboxRom, sizeof(uint16_t), sfxboxRomSize, f); fclose(f);
+  snprintf(path, sizeof path, "%s/wram_exec.bin", dir);
+  f = fopen(path, "wb"); if(!f) return -1;
+  fwrite(sfxboxWramExec, 1, sizeof sfxboxWramExec, f); fclose(f);
+  snprintf(path, sizeof path, "%s/gsuram_exec.bin", dir);
+  f = fopen(path, "wb"); if(!f) return -1;
+  fwrite(sfxboxGsuRamExec, 1, sizeof sfxboxGsuRamExec, f); fclose(f);
+  snprintf(path, sizeof path, "%s/edges.csv", dir);
+  f = fopen(path, "w"); if(!f) return -1;
+  fprintf(f, "cpu,kind,from,to,count\n");
+  for(auto& [k, n] : sfxboxEdges)
+    fprintf(f, "%s,%03x,%06x,%06x,%u\n", k >> 63 ? "gsu" : "cpu", (unsigned)(k >> 48 & 0x1ff),
+            (unsigned)(k >> 24 & 0xffffff), (unsigned)(k & 0xffffff), n);
+  fclose(f);
+  return 0;
+}
+
+extern "C" RETRO_API uint8_t* sfxbox_memory(const char* name, size_t* size) {
+  if(!strcmp(name, "wram")) return sfxbox_core_memory(0, size);
+  if(!strcmp(name, "gsuram")) return sfxbox_core_memory(1, size);
+  if(!strcmp(name, "rom")) return sfxbox_core_memory(2, size);
+  *size = 0;
+  return nullptr;
+}
