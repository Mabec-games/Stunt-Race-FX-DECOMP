+//Spend `clocks` as idle bus cycles (so DMA and HDMA still run), then finish
+//in 2-clock steps.
+auto CPU::sfxboxCharge(uint clocks) -> void {
+  uint start = counter.cpu;
+  while(counter.cpu - start + 6 <= clocks) idle();
+  while(counter.cpu - start < clocks) step<2,1>();
+}
+
+//Repeat a recorded sequence of bus cycles without their bus effects: the same
+//steps, DMA edges and interrupt polls a routine made, in the same order.
+//Each op: high nibble kind (1 read, 2 write, 3 idle, 4 poll), low nibble clocks/2.
+auto CPU::sfxboxReplay(const uint8_t* ops, uint n) -> void {
+  for(uint i : range(n)) {
+    uint kind = ops[i] >> 4, clocks = (ops[i] & 15) * 2;
+    if(kind == 1) {
+      status.clockCount = clocks;
+      dmaEdge();
+      if(clocks == 6) step<2,1>(); else if(clocks == 8) step<4,1>(); else step<8,1>();
+      status.irqLock = 0;
+      step<4,0>();
+      aluEdge();
+    } else if(kind == 2) {
+      aluEdge();
+      status.clockCount = clocks;
+      dmaEdge();
+      if(clocks == 6) step<6,1>(); else if(clocks == 8) step<8,1>(); else step<12,1>();
+      status.irqLock = 0;
+    } else if(kind == 3) {
+      status.clockCount = 6;
+      dmaEdge();
+      step<6,0>();
+      status.irqLock = 0;
+      aluEdge();
+    } else if(kind == 4) {
+      lastCycle();
+    }
+  }
+}
