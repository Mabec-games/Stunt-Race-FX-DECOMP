+    } else if(kind == 3) {
+      status.clockCount = 6;
+      dmaEdge();
+      step<6,0>();
+      status.irqLock = 0;
+      aluEdge();
+    } else if(kind == 4) {
+      lastCycle();
+    }
+  }
