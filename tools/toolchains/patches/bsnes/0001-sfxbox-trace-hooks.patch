+  uint32 at = sfxboxPipeAddr;
   regs.pipeline = readOpcode(++regs.r[15]);
+  sfxboxPipeAddr = regs.pbr << 16 | regs.r[15];
   regs.r[15].modified = false;
+  sfxbox_gsu_operand(at);
   return result;
 }
 
