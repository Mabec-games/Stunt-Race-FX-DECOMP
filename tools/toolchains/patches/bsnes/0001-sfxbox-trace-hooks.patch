+#pragma once
+// Trace and dispatch hooks for the sfxbox harness. The core calls these;
+// the harness (target-libretro/sfxbox.cpp) defines them.
+#include <stdint.h>
+
+enum : uint16_t {
+  SFXBOX_CPU_OP = 1 << 0, SFXBOX_CPU_OPND = 1 << 1, SFXBOX_CPU_DATA = 1 << 2, SFXBOX_DMA = 1 << 3,
+  SFXBOX_GSU_OP = 1 << 4, SFXBOX_GSU_OPND = 1 << 5, SFXBOX_GSU_DATA = 1 << 6,
+  SFXBOX_M8 = 1 << 8, SFXBOX_M16 = 1 << 9, SFXBOX_X8 = 1 << 10, SFXBOX_X16 = 1 << 11, SFXBOX_EMU = 1 << 12,
+};
+enum { SFXBOX_WHO_DATA = 0, SFXBOX_WHO_OP = 1, SFXBOX_WHO_OPND = 2, SFXBOX_WHO_DMA = 3, SFXBOX_WHO_NONE = 5 };
+
+extern "C" {
+extern int sfxbox_cpu_who;
+extern int sfxbox_cpu_first;
+extern uint32_t sfxbox_cpu_fetch_end;
+extern uint8_t sfxbox_cpu_opcode;
+extern int sfxbox_cpu_irq;
+void sfxbox_cpu_rom(uint32_t offset);
+void sfxbox_cpu_insn(uint32_t pc, int m, int x, int e, int db, int d);
+extern int (*sfxbox_cpu_exec)(uint32_t pc);
+void sfxbox_gsu_insn(uint32_t addr);
+void sfxbox_gsu_operand(uint32_t addr);
+void sfxbox_gsu_data(uint32_t addr);
+// Per-access events for the call oracle (kind: 0 S-CPU write, 2 DMA write).
+void sfxbox_cpu_write(uint32_t addr, uint8_t data, int kind);
+void sfxbox_cpu_read(uint32_t addr, uint8_t data);
+void sfxbox_cpu_interrupt(uint32_t resume_pc, uint16_t s);
+// Bus-cycle events (1 read, 2 write, 3 idle, 4 interrupt poll), for replay.
+void sfxbox_cpu_timing(int kind, int clocks, uint32_t addr);
+// One real S-CPU bus access with the CPU's own timing (read when write == 0).
+uint8_t sfxbox_core_access(int write, uint32_t addr, uint8_t data);
+void sfxbox_core_replay(const uint8_t* ops, uint32_t n);
+struct SfxboxRegs { uint16_t a, x, y, s, d; uint8_t db, p, e; uint32_t pc; };
+void sfxbox_core_regs(struct SfxboxRegs* out);
+void sfxbox_core_set_regs(const struct SfxboxRegs* in);
+// Take the pending interrupt from the given state and run its handler until it
+// returns there (0 when none is pending).
+int sfxbox_core_interrupt_here(const struct SfxboxRegs* at);
+// Run original code from a state until PC and S reach the given values.
+void sfxbox_core_run_until(const struct SfxboxRegs* from, uint32_t pc, uint16_t s);
+uint32_t sfxbox_core_clock(void);
+void sfxbox_core_charge(uint32_t clocks);
+uint8_t sfxbox_core_bus_read(uint32_t addr);
+void sfxbox_core_bus_write(uint32_t addr, uint8_t data);
+// Machine state for frame comparison: WRAM 128K, GSU RAM 64K, VRAM 64K,
+// OAM 544, CGRAM 512, APU RAM 64K, in that order.
+enum { SFXBOX_SNAPSHOT_SIZE = 0x20000 + 0x10000 + 0x10000 + 544 + 512 + 0x10000 };
+void sfxbox_core_snapshot(uint8_t* out);
+}
