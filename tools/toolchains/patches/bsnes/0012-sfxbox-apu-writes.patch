+extern void (*sfxbox_apu_write)(uint16_t address, uint8_t data, int dsp_phase);
 void sfxbox_gsu_insn(uint32_t addr);
 // SPC700: an instruction starts at pc; an opcode or operand byte is fetched
 // (with its value); a data read.
