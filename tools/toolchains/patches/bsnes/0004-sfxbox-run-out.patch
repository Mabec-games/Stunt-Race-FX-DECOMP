+//Run original code from the given state (routine swapping off) until a
+//return (RTS, RTL or RTI) takes the stack pointer above s: code C calls or
+//jumps to, stopped where it leaves its frame, by its own return or through
+//its caller's.
+extern "C" void sfxbox_core_run_out(const struct SfxboxRegs* from, uint16_t s) {
+  using namespace SuperFamicom;
+  sfxbox_core_set_regs(from);
+  auto exec = sfxbox_cpu_exec;
+  sfxbox_cpu_exec = nullptr;
+  do { sfxbox_cpu_opcode = 0; cpu.main(); }
+  while(cpu.r.s.w <= s || (sfxbox_cpu_opcode != 0x60 && sfxbox_cpu_opcode != 0x6b && sfxbox_cpu_opcode != 0x40));
+  sfxbox_cpu_exec = exec;
+}
